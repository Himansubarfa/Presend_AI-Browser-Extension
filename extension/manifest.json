{
  "manifest_version": 3,
  "name": "PreSendAI - Privacy Masking",
  "version": "1.0.0",
  "description": "Automatically detect and mask sensitive information (PII) as you type.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PreSendAI"
  },
  "background": {
    "service_worker": "background.js"
  }
}